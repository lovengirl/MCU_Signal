{ Generated by TI_MCU signal bridge. Run AuditSignals first.
  Dedicated unconnected, single-part MCU template sheet only.
  Pin.Location is used as the placed pin's electrical connection point.
  No project compile, save, ECO or PCB routing is performed. }
var
    Pins : array[0..12] of String;
    Nets : array[0..12] of String;
    Found : array[0..12] of Integer;
    PX : array[0..12] of Integer;
    PY : array[0..12] of Integer;
    Existing : array[0..12] of Boolean;

procedure LoadMapping;
begin
    Pins[0] := '47'; Nets[0] := 'TX_ADDR0';
    Pins[1] := '48'; Nets[1] := 'TX_ADDR1';
    Pins[2] := '50'; Nets[2] := 'TX_ADDR2';
    Pins[3] := '51'; Nets[3] := 'TX_ADDR3';
    Pins[4] := '52'; Nets[4] := 'TX_ADDR4';
    Pins[5] := '58'; Nets[5] := 'RX_ADDR0';
    Pins[6] := '59'; Nets[6] := 'RX_ADDR1';
    Pins[7] := '60'; Nets[7] := 'RX_ADDR2';
    Pins[8] := '61'; Nets[8] := 'RX_ADDR3';
    Pins[9] := '62'; Nets[9] := 'RX_ADDR4';
    Pins[10] := '53'; Nets[10] := 'TX_EN';
    Pins[11] := '63'; Nets[11] := 'RX_EN';
    Pins[12] := '8'; Nets[12] := 'LIGHT_SET';
end;

procedure ProcessSignals(DoApply : Boolean);
var
    Doc, It, Comp, Target, Pit, PinObj, Obj, LabelObj : Variant;
    i, j, Count, Total : Integer;
    Report, Errors : String;
begin
    LoadMapping;
    Doc := SchServer.GetCurrentSchDocument;
    if Doc = Nil then begin ShowMessage('Open a copied MCU template SchDoc first.'); Exit; end;
    Count := 0;
    Total := 0;
    Target := Nil;
    It := Doc.SchIterator_Create;
    try
        It.AddFilter_ObjectSet(MkSet(eSchComponent));
        Comp := It.FirstSchObject;
        while Comp <> Nil do
        begin
            Total := Total + 1;
            if Comp.Selection then begin Count := Count + 1; Target := Comp; end;
            Comp := It.NextSchObject;
        end;
    finally
        Doc.SchIterator_Destroy(It);
    end;
    if Count <> 1 then begin ShowMessage('Select exactly one MSPM0G3507SPMR component.'); Exit; end;
    if Total <> 1 then begin ShowMessage('Use a dedicated sheet with only the MCU component.'); Exit; end;
    if Pos('MSPM0G3507', UpperCase(Target.LibReference)) = 0 then
    begin ShowMessage('MCU library reference must contain MSPM0G3507. Check the device/package.'); Exit; end;
    Errors := '';
    Report := 'Target: ' + Target.Designator.Text + #13#10;
    { Limit the first implementation to a dedicated sheet; do not rename routed nets. }
    It := Doc.SchIterator_Create;
    try
        It.AddFilter_ObjectSet(MkSet(eWire, eBus, ePort, ePowerObject, eSheetSymbol, eJunction));
        if It.FirstSchObject <> Nil then Errors := Errors + 'Use an unconnected dedicated MCU template sheet (no wires/ports/power/buses/harnesses).' + #13#10;
    finally
        Doc.SchIterator_Destroy(It);
    end;
    for i := 0 to 12 do begin Found[i] := 0; Existing[i] := False; end;
    Pit := Target.SchIterator_Create;
    try
        Pit.AddFilter_ObjectSet(MkSet(ePin));
        PinObj := Pit.FirstSchObject;
        while PinObj <> Nil do
        begin
            for i := 0 to 12 do
                if PinObj.Designator = Pins[i] then
                begin
                    Found[i] := Found[i] + 1;
                    PX[i] := PinObj.Location.X; PY[i] := PinObj.Location.Y;
                    if PinObj.IsHidden then Errors := Errors + 'Hidden pin: ' + Pins[i] + #13#10;
                    if (PinObj.OwnerPartId <> 0) and (PinObj.OwnerPartId <> Target.CurrentPartID) then
                        Errors := Errors + 'All target pins must be visible in one part: ' + Pins[i] + #13#10;
                end;
            PinObj := Pit.NextSchObject;
        end;
    finally
        Target.SchIterator_Destroy(Pit);
    end;
    for i := 0 to 12 do
    begin
        if Found[i] <> 1 then Errors := Errors + 'Missing/duplicate physical pin: ' + Pins[i] + #13#10;
        for j := 0 to i-1 do
            if (Found[i] = 1) and (Found[j] = 1) and (PX[i] = PX[j]) and (PY[i] = PY[j]) then
                Errors := Errors + 'Overlapping target pins.' + #13#10;
        Report := Report + Pins[i] + ' -> ' + Nets[i] + ' @ ' + IntToStr(PX[i]) + ',' + IntToStr(PY[i]) + #13#10;
    end;
    { Matching labels make reruns idempotent. Unknown labels require manual review. }
    It := Doc.SchIterator_Create;
    try
        It.AddFilter_ObjectSet(MkSet(eNetLabel));
        Obj := It.FirstSchObject;
        while Obj <> Nil do
        begin
            Count := 0;
            for i := 0 to 12 do
                if (Found[i] = 1) and (Obj.Location.X = PX[i]) and (Obj.Location.Y = PY[i]) then
                begin
                    Count := Count + 1;
                    if (Obj.Text <> Nets[i]) or Existing[i] then Errors := Errors + 'Conflicting/duplicate label on pin ' + Pins[i] + #13#10;
                    Existing[i] := True;
                end;
            if Count = 0 then Errors := Errors + 'Unmanaged net label on sheet.' + #13#10;
            Obj := It.NextSchObject;
        end;
    finally
        Doc.SchIterator_Destroy(It);
    end;
    if Errors <> '' then begin ShowMessage('Preflight failed; no changes:' + #13#10 + Errors); Exit; end;
    if not DoApply then begin ShowMessage('Audit only; no changes.' + #13#10 + Report); Exit; end;
    SchServer.ProcessControl.PreProcess(Doc, '');
    try
        for i := 0 to 12 do
            if not Existing[i] then
            begin
                LabelObj := SchServer.SchObjectFactory(eNetLabel, eCreate_Default);
                LabelObj.Location := Point(PX[i], PY[i]);
                LabelObj.Text := Nets[i];
                LabelObj.Orientation := eRotate0;
                Doc.RegisterSchObjectInContainer(LabelObj);
                SchServer.RobotManager.SendMessage(Doc.I_ObjectAddress, c_BroadCast, SCHM_PrimitiveRegistration, LabelObj.I_ObjectAddress);
            end;
    finally
        SchServer.ProcessControl.PostProcess(Doc, '');
    end;
    Doc.GraphicallyInvalidate;
    ShowMessage('Labels inserted. Compile/ERC and exported pin-to-net verification are required before saving.' + #13#10 + Report);
end;

procedure AuditSignals;
begin
    ProcessSignals(False);
end;

procedure ApplySignals;
begin
    ProcessSignals(True);
end;
